# Copy to .env and fill in your values. Never commit .env to version control.

# Provider API keys (OpenAI, Groq, etc.)
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Bifrost virtual keys (create via Bifrost dashboard at http://localhost:8080)
BIFROST_OPENAI_API_KEY=your-bifrost-openai-virtual-key
BIFROST_GROQ_API_KEY=your-bifrost-groq-virtual-key
