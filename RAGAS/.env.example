OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
RAGAS_JUDGE_MODEL=gpt-4o-mini

# personalChatBot eval endpoint
CHATBOT_BASE_URL=http://127.0.0.1:8000
EVAL_SECRET=change-me-to-a-long-random-secret

# Optional: load OPENAI_API_KEY from personalChatBot/.env automatically when set
# CHATBOT_ROOT=C:/Users/you/Desktop/personalChatBot

# Optional overrides
# EVAL_DATASET_PATH=data/golden/v1.json
# BASELINE_PATH=baselines/baseline-v1.json
# REPORTS_DIR=reports
# EVAL_CONCURRENCY=2
# REGRESSION_DROP_LIMIT=0.05
